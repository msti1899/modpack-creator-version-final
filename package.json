{
  "name": "modpack-creator",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@modpack/*' dev",
    "dev:web": "bun run --filter @modpack/web dev",
    "dev:api": "bun run --filter @modpack/api dev",
    "typecheck": "bun run --filter '@modpack/*' typecheck",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:web",
    "build": "bun run --filter @modpack/web build",
    "db:start": "bash scripts/db-local.sh start",
    "db:stop": "bash scripts/db-local.sh stop",
    "db:status": "bash scripts/db-local.sh status",
    "db:reset": "bash scripts/db-local.sh reset",
    "db:test": "bash scripts/db-local.sh test",
    "db:test:upgrade": "bun scripts/test-profile-upgrade.ts",
    "db:test:concurrency": "bun scripts/test-concurrency.ts",
    "db:test:postgrest": "bun scripts/test-postgrest.ts",
    "test:web": "bun run --filter @modpack/web test",
    "test:e2e": "bun run --filter @modpack/web test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "supabase": "3.0.0"
  }
}
