PORT=3001
# From the SAME Clerk instance used by apps/web; never paste keys into chat/logs.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# JWT PUBLIC key, not the Clerk secret key. Literal \n is supported.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-clerk-public-key\n-----END PUBLIC KEY-----"
# Exact browser origins that may obtain sessions for this API (not the API URL).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000

# Supabase database access only; configure Clerk third-party trust separately.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-legacy-anon-key
